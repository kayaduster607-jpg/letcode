{
  "name": "letcode",
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "generate:videos": "node scripts/generate_hot100_case_videos.mjs ./ship",
    "qa:video-assets": "node --experimental-strip-types scripts/verify_video_assets.mjs",
    "qa:content": "node scripts/qa_hot100.mjs",
    "verify": "pnpm run typecheck && pnpm run qa:content && pnpm run qa:video-assets && pnpm audit --audit-level=moderate && pnpm run build",
    "qa:python": "python scripts/qa_hot100.py && python scripts/check_python39_compat.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "next": "16.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.5",
      "nanoid@^3.0.0": "3.3.18",
      "source-map-js": "1.2.2",
      "baseline-browser-mapping": "2.11.0"
    }
  }
